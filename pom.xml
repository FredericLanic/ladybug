<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.kycox</groupId>
	<artifactId>ladybug</artifactId>
	<version>0.9.0-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>${application.name}</name>
	<url>http://maven.apache.org</url>
	
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
    </parent>

	<properties>
		<java.version>21</java.version>
		<!-- Faille connue de log4j-api 2.24.3 (version de Spring Boot 3.5.16), corrigée en 2.25.5
		     (alerte Dependabot n° 82). À retirer quand Spring Boot fournira une version corrigée. -->
		<log4j2.version>2.25.5</log4j2.version>
		<!-- PIT (3.5.5) : réglables en ligne de commande, par exemple -Dpit.threads=2 pour la CI -->
		<pit.threads>4</pit.threads>
		<pit.timeoutFactor>1.25</pit.timeoutFactor>
		<pit.excludedTests>com.kycox.game.NoTestExcluded</pit.excludedTests>
		<application.name>Ladybug by Kykox</application.name>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<start-class>com.kycox.game.Application</start-class>
		<!-- Rempli par JaCoCo (agent de couverture) ; vide si JaCoCo ne tourne pas -->
		<argLine></argLine>
		<!-- SonarQube Cloud (étape 5 bis) : analyse lancée par la CI (build.yml) quand le
		     secret SONAR_TOKEN existe. Clés à confirmer à la création du projet sur sonarcloud.io.
		     La couverture vient du rapport JaCoCo (target/site/jacoco/jacoco.xml, lu par défaut). -->
		<sonar.organization>fredericlanic</sonar.organization>
		<sonar.projectKey>FredericLanic_ladybug</sonar.projectKey>
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
	</properties>

	<dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
	    <dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<!-- version gérée par Spring Boot (1.18.46 avec Spring Boot 3.5.16) -->
			<scope>provided</scope>
		</dependency>
		<!-- manette xbox : fork libGDX de Jamepad (SDL 2.30), natives Windows, Linux et macOS
		     dont Apple Silicon ; sur Maven Central (étape 3.5.3d) -->
		<dependency>
			<groupId>com.badlogicgames.jamepad</groupId>
			<artifactId>jamepad</artifactId>
			<version>2.30.0.0</version>
		</dependency>
		<!-- tests : JUnit 5, AssertJ, Mockito (versions gérées par Spring Boot) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- ArchUnit (étape 5 bis) : règles d'architecture vérifiées comme des tests
		     (qui a le droit de dépendre de qui) ; voir ArchitectureTest -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>1.5.1</version>
			<scope>test</scope>
		</dependency>
    </dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>**/_inWork/**/*.*</exclude>
				</excludes>
				<!--filtering>true</filtering-->
			</resource>
		</resources>

		<pluginManagement>
			<plugins>
				<!-- version du scanner SonarQube Cloud, lancé par la CI :
				     mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -->
				<plugin>
					<groupId>org.sonarsource.scanner.maven</groupId>
					<artifactId>sonar-maven-plugin</artifactId>
					<version>5.8.0.7211</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Mockito chargé comme agent Java : évite l'avertissement « self-attaching » de Java 21
			     (https://javadoc.io/doc/org.mockito/mockito-core/latest/org.mockito/org/mockito/Mockito.html#0.3) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- @{argLine} : l'agent JaCoCo, ajouté au moment de lancer les tests -->
					<argLine>@{argLine} -Xshare:off -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
			<!-- JaCoCo (étape 5 bis) : mesure la couverture, c'est-à-dire les lignes et les
			     branches réellement exécutées par les tests. Lancé par mvn verify.
			     Rapport : target/site/jacoco/index.html (aussi en XML, lu par SonarQube Cloud).
			     Complète PIT : JaCoCo dit « ce code a tourné », PIT dit « une erreur ici
			     aurait été vue ». -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.16</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- PIT, tests de mutation (étape 3.5.5) : glisse de petites erreurs dans le code
			     (« mutants ») et vérifie que les tests les détectent. Lent : lancé à la demande,
			     mvn test-compile org.pitest:pitest-maven:mutationCoverage
			     Rapport : target/pit-reports/index.html -->
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.19.1</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>1.2.2</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetClasses>
						<param>com.kycox.game.*</param>
					</targetClasses>
					<targetTests>
						<param>com.kycox.game.*</param>
					</targetTests>
					<!-- hors périmètre jusqu'aux images clés (C30, C34) : le dessin Swing et le
					     démarrage, vérifiés par le robot et les parties de Frédéric -->
					<excludedClasses>
						<param>com.kycox.game.engine.view.*</param>
						<param>com.kycox.game.Application</param>
						<param>com.kycox.game.MainLadybug</param>
						<param>com.kycox.game.engine.Engine</param>
					</excludedClasses>
					<!-- seuil (C35) : la construction échoue si moins de 60 % des mutants sont détectés -->
					<mutationThreshold>60</mutationThreshold>
					<jvmArgs>
						<jvmArg>-Xshare:off</jvmArg>
						<jvmArg>-javaagent:${org.mockito:mockito-core:jar}</jvmArg>
					</jvmArgs>
					<threads>${pit.threads}</threads>
					<timeoutFactor>${pit.timeoutFactor}</timeoutFactor>
					<excludedTestClasses>
						<param>${pit.excludedTests}</param>
					</excludedTestClasses>
					<timestampedReports>false</timestampedReports>
					<outputFormats>
						<format>HTML</format>
						<format>XML</format>
					</outputFormats>
				</configuration>
			</plugin>
			<!-- Publication d'une version (workflow maven-release.yml) : seul release:prepare est utilisé.
			     Il passe le pom en version finale, lance les tests, commite, pose le tag vX.Y.Z,
			     puis passe à la version SNAPSHOT suivante. Pas de dépôt Maven : le jar part
			     dans une GitHub Release (décision C39). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<tagNameFormat>v@{project.version}</tagNameFormat>
					<scmCommentPrefix>[Release] </scmCommentPrefix>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- Adresse du dépôt Git, indispensable à release:prepare pour pousser commits et tag -->
	<scm>
		<connection>scm:git:https://github.com/FredericLanic/ladybug.git</connection>
		<developerConnection>scm:git:https://github.com/FredericLanic/ladybug.git</developerConnection>
		<url>https://github.com/FredericLanic/ladybug</url>
		<tag>HEAD</tag>
	</scm>

</project>
