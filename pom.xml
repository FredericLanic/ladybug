<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.kycox</groupId>
	<artifactId>ladybug</artifactId>
	<version>0.6.0-SNAPSHOT</version>
	<packaging>jar</packaging>
	<name>${application.name}</name>
	<url>http://maven.apache.org</url>
	
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
    </parent>

	<properties>
		<java.version>21</java.version>
		<application.name>Ladybug by Kykox</application.name>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<start-class>com.kycox.game.Application</start-class>
	</properties>

	<dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
	    <dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<!-- version gérée par Spring Boot (1.18.46 avec Spring Boot 3.5.16) -->
			<scope>provided</scope>
		</dependency>
		<!-- manette xbox : fork libGDX de Jamepad (SDL 2.30), natives Windows, Linux et macOS
		     dont Apple Silicon ; sur Maven Central (étape 3.5.3d) -->
		<dependency>
			<groupId>com.badlogicgames.jamepad</groupId>
			<artifactId>jamepad</artifactId>
			<version>2.30.0.0</version>
		</dependency>
		<!-- tests : JUnit 5, AssertJ, Mockito (versions gérées par Spring Boot) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
    </dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>**/_inWork/**/*.*</exclude>
				</excludes>
				<!--filtering>true</filtering-->
			</resource>
		</resources>

		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Mockito chargé comme agent Java : évite l'avertissement « self-attaching » de Java 21
			     (https://javadoc.io/doc/org.mockito/mockito-core/latest/org.mockito/org/mockito/Mockito.html#0.3) -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>-Xshare:off -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
